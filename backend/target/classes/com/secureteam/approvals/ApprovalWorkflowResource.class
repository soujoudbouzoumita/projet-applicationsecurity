package com.secureteam.approvals;

import jakarta.enterprise.context.ApplicationScoped;
import jakarta.ws.rs.Consumes;
import jakarta.ws.rs.GET;
import jakarta.ws.rs.POST;
import jakarta.ws.rs.Path;
import jakarta.ws.rs.PathParam;
import jakarta.ws.rs.Produces;
import jakarta.ws.rs.core.Response;
import jakarta.ws.rs.core.Response.Status;
import java.util.ArrayList;
import java.util.List;
import java.util.UUID;

@Path("/approvals")
@ApplicationScoped
@Produces({"application/json"})
@Consumes({"application/json"})
public class ApprovalWorkflowResource {
   private final List requests = new ArrayList();

   @POST
   @Path("/request")
   public Response requestAccess(com.secureteam.approvals.ApprovalWorkflowResource.AccessRequest request) {
      request.setId(UUID.randomUUID().toString());
      request.setStatus("PENDING");
      this.requests.add(request);
      return Response.status(Status.ACCEPTED).entity(request).build();
   }

   @GET
   @Path("/pending")
   public List getPendingRequests() {
      return this.requests.stream().filter((r) -> {
         return "PENDING".equals(r.getStatus());
      }).toList();
   }

   @POST
   @Path("/approve/{id}")
   public Response approveRequest(@PathParam("id") String id) {
      return (Response)this.requests.stream().filter((r) -> {
         return r.getId().equals(id);
      }).findFirst().map((r) -> {
         r.setStatus("APPROVED");
         return Response.ok(r).build();
      }).orElse(Response.status(Status.NOT_FOUND).build());
   }
}

