# Configuration SecureTeam Access - Variables d'environnement

# ============= DATABASE (PostgreSQL) =============
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secureteam_access_db
DB_USER=sentinel_admin
DB_PASSWORD=secure_password_123!
DB_DRIVER=org.postgresql.Driver
DB_URL=jdbc:postgresql://localhost:5432/secureteam_access_db

# ============= CACHE (Redis) =============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=2000

# ============= MFA CONFIGURATION =============
MFA_ISSUER=SecureTeamAccess
MFA_WINDOW=3  # +/- 3 minutes for clock drift

# ============= SECURITY =============
PASETO_SECRET_KEY=your-secret-key-here-min-32-chars
PASETO_PUBLIC_KEY=your-public-key-here
JWT_EXPIRATION_HOURS=24

# ============= MINIO (Optional - for Steganography) =============
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=secure_minio_password_123!
MINIO_BUCKET=secureteam-covers

# ============= ENCRYPTION & SECRETS =============
SECRET_MASTER_PASSWORD=change_me_in_prod_master_password_must_be_32_chars!
SECRET_ENCRYPTION_SALT=change_me_in_prod_salt_must_be_32_chars!
SECRET_ENCRYPTION_PEPPER=change_me_in_prod_pepper_must_be_32_chars!

# ============= CORS =============
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type

# ============= LOGGING =============
LOG_LEVEL=INFO
LOG_FILE=/var/log/secureteam/secureteam-access.log
